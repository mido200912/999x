---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  role?: "CLIENT_ADMIN" | "OPS_MEMBER" | "SUPER_ADMIN";
}

const { title, role = "CLIENT_ADMIN" } = Astro.props;
const currentPath = Astro.url.pathname;
const isClientSection = currentPath.startsWith("/client");
const isAdminSection = currentPath.startsWith("/admin");

const isActive = (path: string) => {
  if (path === "/client/dashboard" && (currentPath === "/client/dashboard" || currentPath === "/client/dashboard/")) return true;
  if (path === "/admin/cockpit" && (currentPath === "/admin/cockpit" || currentPath === "/admin/cockpit/")) return true;
  return currentPath === path || currentPath === path + "/" || (path !== "/" && currentPath.startsWith(path));
};
---

<BaseLayout title={title}>
  <div class="min-h-screen flex flex-col lg:flex-row">
    <!-- Desktop & Tablet Sidebar -->
    <aside class="hidden lg:flex w-[290px] shrink-0 flex-col border-l border-white/10 sticky top-0 h-screen z-40" style="background: rgba(22, 3, 34, 0.94); backdrop-filter: blur(28px);">
      <!-- Brand Header -->
      <div class="h-[76px] flex items-center gap-3 px-5 border-b border-white/10">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl overflow-hidden border border-lime/30 group-hover:border-lime group-hover:shadow-[0_0_16px_rgba(163,230,53,0.35)] transition">
            <img src="/logo_999x.jpg" class="w-full h-full object-cover" alt="999x Logo" />
          </div>
          <div>
            <div class="font-unbounded font-black text-pistachio text-[15px] tracking-tight group-hover:text-lime transition flex items-center gap-1.5">
              999x <span class="text-[10px] px-1.5 py-0.5 rounded bg-lime/15 text-lime border border-lime/25 font-mono">v2.4</span>
            </div>
            <div class="font-mono text-[10px] tracking-[0.16em] text-pistachio/50">OPERATIONS HUB</div>
          </div>
        </a>
      </div>

      <!-- Quick Section Switcher: Client vs Ops -->
      <div class="p-3 border-b border-white/[0.08]">
        <div class="grid grid-cols-2 p-1 rounded-xl bg-canvas border border-white/10 text-[11px] font-bold font-display">
          <a
            href="/client/dashboard"
            class={`py-1.5 text-center rounded-lg transition ${
              isClientSection
                ? "bg-lime text-canvas shadow-[0_2px_10px_rgba(163,230,53,0.3)] font-black"
                : "text-pistachio/70 hover:text-white"
            }`}
          >
            بوابة العميل
          </a>
          <a
            href="/admin/cockpit"
            class={`py-1.5 text-center rounded-lg transition ${
              isAdminSection
                ? "bg-lime text-canvas shadow-[0_2px_10px_rgba(163,230,53,0.3)] font-black"
                : "text-pistachio/70 hover:text-white"
            }`}
          >
            غرفة العمليات
          </a>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="p-4 space-y-5 flex-1 overflow-y-auto">
        <!-- Client Hub Links -->
        <div>
          <div class="px-2 mb-2 text-[10.5px] font-mono tracking-widest text-pistachio/40 uppercase flex items-center justify-between">
            <span>بوابة العميل • CLIENT PORTAL</span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          </div>
          <div class="space-y-1">
            <a
              href="/client/dashboard"
              class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-[13px] font-display transition ${
                isActive("/client/dashboard")
                  ? "bg-lime text-canvas font-black shadow-[0_4px_16px_rgba(163,230,53,0.25)]"
                  : "text-pistachio/80 hover:bg-white/5 hover:text-white"
              }`}
            >
              <div class="flex items-center gap-2.5">
                <span class="text-[15px]">📊</span>
                <span>لوحة التحكم والمخرجات</span>
              </div>
              {isActive("/client/dashboard") && <span class="text-[10px] font-mono font-bold">●</span>}
            </a>

            <a
              href="/client/roadmap"
              class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-[13px] font-display transition ${
                isActive("/client/roadmap")
                  ? "bg-lime text-canvas font-black shadow-[0_4px_16px_rgba(163,230,53,0.25)]"
                  : "text-pistachio/80 hover:bg-white/5 hover:text-white"
              }`}
            >
              <div class="flex items-center gap-2.5">
                <span class="text-[15px]">🗺️</span>
                <span>رادار خارطة الطريق</span>
              </div>
              {isActive("/client/roadmap") && <span class="text-[10px] font-mono font-bold">●</span>}
            </a>

            <a
              href="/client/tickets"
              class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-[13px] font-display transition ${
                isActive("/client/tickets")
                  ? "bg-lime text-canvas font-black shadow-[0_4px_16px_rgba(163,230,53,0.25)]"
                  : "text-pistachio/80 hover:bg-white/5 hover:text-white"
              }`}
            >
              <div class="flex items-center gap-2.5">
                <span class="text-[15px]">🎫</span>
                <span>تذاكر الطوارئ وواتساب</span>
              </div>
              <span class="px-1.5 py-0.5 rounded text-[9.5px] font-mono font-bold bg-amber-400/20 text-amber-300">1 نشطة</span>
            </a>
          </div>
        </div>

        <!-- Internal Ops Links -->
        <div>
          <div class="px-2 mb-2 text-[10.5px] font-mono tracking-widest text-pistachio/40 uppercase flex items-center justify-between">
            <span>غرفة العمليات المركزية • OPS WAR ROOM</span>
            <span class="w-1.5 h-1.5 rounded-full bg-lime animate-pulse"></span>
          </div>
          <div class="space-y-1">
            <a
              href="/admin/cockpit"
              class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-[13px] font-display transition ${
                isActive("/admin/cockpit")
                  ? "bg-lime text-canvas font-black shadow-[0_4px_16px_rgba(163,230,53,0.25)]"
                  : "text-pistachio/80 hover:bg-white/5 hover:text-white"
              }`}
            >
              <div class="flex items-center gap-2.5">
                <span class="text-[15px]">⚡</span>
                <span>قمرة العمليات (Kanban)</span>
              </div>
              {isActive("/admin/cockpit") && <span class="text-[10px] font-mono font-bold">●</span>}
            </a>

            <a
              href="/admin/ai-studio"
              class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-[13px] font-display transition ${
                isActive("/admin/ai-studio")
                  ? "bg-lime text-canvas font-black shadow-[0_4px_16px_rgba(163,230,53,0.25)]"
                  : "text-pistachio/80 hover:bg-white/5 hover:text-white"
              }`}
            >
              <div class="flex items-center gap-2.5">
                <span class="text-[15px]">🧪</span>
                <span>استوديو نماذج الذكاء (AI)</span>
              </div>
              <span class="px-1.5 py-0.5 rounded text-[9.5px] font-mono font-bold bg-violet-deep/60 text-violet-300 border border-violet/30">L2 Cache</span>
            </a>

            <a
              href="/admin/crm"
              class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-[13px] font-display transition ${
                isActive("/admin/crm")
                  ? "bg-lime text-canvas font-black shadow-[0_4px_16px_rgba(163,230,53,0.25)]"
                  : "text-pistachio/80 hover:bg-white/5 hover:text-white"
              }`}
            >
              <div class="flex items-center gap-2.5">
                <span class="text-[15px]">👥</span>
                <span>سجل ذكاء العملاء (CRM)</span>
              </div>
              {isActive("/admin/crm") && <span class="text-[10px] font-mono font-bold">●</span>}
            </a>
          </div>
        </div>

        <!-- Global Quick Actions -->
        <div class="pt-2">
          <div class="px-2 mb-2 text-[10.5px] font-mono tracking-widest text-pistachio/40 uppercase">
            <span>الوصول السريع</span>
          </div>
          <div class="space-y-1">
            <a
              href="/onboarding"
              class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[12.5px] text-pistachio/70 hover:bg-white/5 hover:text-lime transition"
            >
              <span>🚀</span>
              <span>معالج التقديم الذكي (Wizard)</span>
            </a>
            <a
              href="/"
              class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-[12.5px] text-pistachio/70 hover:bg-white/5 hover:text-white transition"
            >
              <span>🌐</span>
              <span>الصفحة الرئيسية للندينج</span>
            </a>
          </div>
        </div>
      </nav>

      <!-- Telemetry Footer -->
      <div class="p-4 border-t border-white/10 space-y-3">
        <div class="rounded-2xl p-3 bg-canvas border border-white/10 space-y-2">
          <div class="flex items-center justify-between text-[11px] font-mono">
            <span class="text-pistachio/50">OPENROUTER BUDGET</span>
            <span class="text-lime font-bold">182K / 200K</span>
          </div>
          <div class="h-1.5 rounded-full bg-white/10 overflow-hidden">
            <div class="h-full bg-gradient-to-r from-lime to-emerald-400" style="width: 91%"></div>
          </div>
          <div class="flex justify-between text-[10px] font-mono text-pistachio/40 pt-0.5">
            <span>Cost: $0.42 / req</span>
            <span>Latency: 14ms</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content Container -->
    <div class="flex-1 min-w-0 flex flex-col">
      <!-- Top Bar -->
      <header class="h-[68px] sticky top-0 z-30 flex items-center justify-between px-4 sm:px-8 border-b border-white/10 backdrop-blur-2xl" style="background: rgba(21, 3, 32, 0.88);">
        <!-- Left: Status & Breadcrumb -->
        <div class="flex items-center gap-3.5">
          <!-- Mobile Drawer Button (visible on small screens) -->
          <button id="mobileNavToggle" class="lg:hidden p-2 rounded-xl bg-surface border border-white/15 text-pistachio hover:text-lime" aria-label="Toggle Menu">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>

          <a href="/" class="lg:hidden flex items-center gap-2">
            <img src="/logo_999x.jpg" class="w-7 h-7 rounded-lg object-cover" alt="" />
            <span class="font-unbounded font-black text-pistachio text-[14px]">999x</span>
          </a>

          <div class="hidden sm:flex items-center gap-2 text-[12px] font-mono">
            <span class="w-2 h-2 rounded-full bg-lime animate-ping"></span>
            <span class="text-lime font-bold">LIVE OPS</span>
            <span class="text-white/20">/</span>
            <span class="text-pistachio/70 font-display font-medium">Enactus Cairo Pod #042</span>
          </div>
        </div>

        <!-- Right: Actions & User Profile -->
        <div class="flex items-center gap-3">
          <a
            href="/onboarding"
            class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-lime/10 text-lime border border-lime/25 text-[11.5px] font-bold hover:bg-lime hover:text-canvas transition"
          >
            <span>+ فحص جديد</span>
          </a>

          <div class="h-6 w-px bg-white/10 hidden sm:block"></div>

          <div class="flex items-center gap-2.5">
            <div class="text-left hidden sm:block">
              <div class="text-[12.5px] font-bold text-pistachio">سارة المنشاوي</div>
              <div class="text-[10.5px] font-mono text-lime">Central Ops Lead</div>
            </div>
            <img src="https://i.pravatar.cc/100?img=32" class="w-9 h-9 rounded-full border border-lime/30 object-cover shadow-[0_0_12px_rgba(163,230,53,0.25)]" alt="Avatar" />
          </div>
        </div>
      </header>

      <!-- Mobile Navigation Drawer Modal -->
      <div id="mobileDrawer" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden transition-opacity">
        <div class="w-[300px] h-full bg-surface border-r border-white/10 p-5 flex flex-col justify-between" dir="rtl">
          <div>
            <div class="flex items-center justify-between pb-4 border-b border-white/10">
              <div class="flex items-center gap-2">
                <img src="/logo_999x.jpg" class="w-8 h-8 rounded-xl object-cover" alt="" />
                <span class="font-unbounded font-black text-pistachio text-[15px]">999x HUB</span>
              </div>
              <button id="closeMobileDrawer" class="p-1.5 text-pistachio/60 hover:text-white text-[18px]">✕</button>
            </div>

            <div class="mt-4 space-y-1 text-[13px]">
              <div class="text-[11px] font-mono text-lime font-bold mb-2">بوابة العميل</div>
              <a href="/client/dashboard" class="block px-3 py-2 rounded-lg text-pistachio hover:bg-white/5">📊 لوحة التحكم</a>
              <a href="/client/roadmap" class="block px-3 py-2 rounded-lg text-pistachio hover:bg-white/5">🗺️ خارطة الطريق</a>
              <a href="/client/tickets" class="block px-3 py-2 rounded-lg text-pistachio hover:bg-white/5">🎫 التذاكر</a>

              <div class="text-[11px] font-mono text-lime font-bold mt-4 mb-2">غرفة العمليات</div>
              <a href="/admin/cockpit" class="block px-3 py-2 rounded-lg text-pistachio hover:bg-white/5">⚡ قمرة العمليات</a>
              <a href="/admin/ai-studio" class="block px-3 py-2 rounded-lg text-pistachio hover:bg-white/5">🧪 استوديو AI</a>
              <a href="/admin/crm" class="block px-3 py-2 rounded-lg text-pistachio hover:bg-white/5">👥 سجل العملاء</a>

              <div class="text-[11px] font-mono text-pistachio/40 mt-4 mb-2">الرئيسية</div>
              <a href="/" class="block px-3 py-2 rounded-lg text-pistachio hover:bg-white/5">🌐 العودة للاندينج</a>
              <a href="/onboarding" class="block px-3 py-2 rounded-lg text-pistachio hover:bg-white/5">🚀 معالج الفحص</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Page Content Slot -->
      <main class="p-4 sm:p-6 lg:p-8 max-w-[1360px] mx-auto w-full flex-1">
        <slot />
      </main>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById("mobileNavToggle");
    const drawer = document.getElementById("mobileDrawer");
    const closeBtn = document.getElementById("closeMobileDrawer");

    toggleBtn?.addEventListener("click", () => {
      drawer?.classList.remove("hidden");
    });
    closeBtn?.addEventListener("click", () => {
      drawer?.classList.add("hidden");
    });
    drawer?.addEventListener("click", (e) => {
      if (e.target === drawer) drawer.classList.add("hidden");
    });
  </script>
</BaseLayout>
