---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
---

<DashboardLayout title="رادار خارطة الطريق التفاعلي — 999x Client Hub">
  <!-- Header & Overall Progress -->
  <div class="glass-panel rounded-3xl p-6 sm:p-8 border-lime/25 shadow-xl space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-lime animate-pulse"></span>
          <span class="font-mono text-[11px] text-lime uppercase tracking-widest">MISSION TIMELINE • CLIENT POD #042</span>
        </div>
        <h1 class="font-display font-black text-[24px] sm:text-[30px] text-pistachio">رادار خارطة الطريق والاعتماد التشغيلي</h1>
        <p class="text-[13.5px] text-pistachio/60 font-sub max-w-2xl mt-1">
          مسار 48 ساعة إلى 6 أسابيع لإعادة هيكلة المنظمة وضبط معدلات التسرب، استقطاب الرعاة، وتثبيت الحوكمة الموثقة رقمياً.
        </p>
      </div>

      <!-- Quick Action: Export Master Plan -->
      <div class="flex items-center gap-3">
        <button id="btnOpenPdfModal" class="px-5 h-11 btn-lime text-[13px] font-bold flex items-center gap-2">
          <span>📄 تصدير الخارطة المعتمدة (PDF)</span>
        </button>
      </div>
    </div>

    <!-- Overall Milestone Progress Bar -->
    <div class="p-4 rounded-2xl bg-canvas border border-white/10 space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2 text-[12px] font-mono">
        <div class="flex items-center gap-3">
          <span class="text-pistachio/60">مستوى الإنجاز الإجمالي:</span>
          <span class="text-lime font-black text-[15px]">46% مكتمل</span>
          <span class="text-white/20">|</span>
          <span class="text-pistachio/70">المرحلة الحالية: <b class="text-amber-300">02. اعتماد الهيكل (RACI)</b></span>
        </div>
        <span class="text-pistachio/40">SLA: متوقع الانتهاء الكامل في 14 يوماً</span>
      </div>

      <div class="h-2.5 rounded-full bg-surface overflow-hidden border border-white/10 relative">
        <div class="h-full bg-gradient-to-r from-lime via-emerald-400 to-lime rounded-full transition-all duration-700 shadow-[0_0_12px_rgba(163,230,53,0.5)]" style="width: 46%;"></div>
      </div>

      <!-- 4 Stages Quick Indicator -->
      <div class="grid grid-cols-4 gap-2 pt-1 text-[11px] font-mono text-center">
        <div class="text-emerald-400 font-bold">✓ 01. التشخيص (100%)</div>
        <div class="text-lime font-bold">● 02. الهيكل (65%)</div>
        <div class="text-pistachio/40">○ 03. الرعاة (20%)</div>
        <div class="text-pistachio/30">○ 04. المتابعة (0%)</div>
      </div>
    </div>
  </div>

  <!-- Filter Pills -->
  <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
    <div class="flex gap-2 text-[12px] font-display" id="stageFilterGroup">
      <button class="stage-filter-btn px-4 py-2 rounded-xl bg-lime text-canvas font-bold transition" data-filter="all">جميع المحطات (4)</button>
      <button class="stage-filter-btn px-4 py-2 rounded-xl bg-surface border border-white/10 text-pistachio/70 hover:border-lime/30 transition" data-filter="completed">المنجزة (1)</button>
      <button class="stage-filter-btn px-4 py-2 rounded-xl bg-surface border border-white/10 text-pistachio/70 hover:border-lime/30 transition" data-filter="active">الجارية (1)</button>
      <button class="stage-filter-btn px-4 py-2 rounded-xl bg-surface border border-white/10 text-pistachio/70 hover:border-lime/30 transition" data-filter="upcoming">القادمة (2)</button>
    </div>

    <div class="text-[11px] font-mono text-pistachio/50">
      اضغط على أي مرحلة لعرض المخرجات وتكليف الذكاء الاصطناعي بإعادة الصياغة
    </div>
  </div>

  <!-- Detailed Stages Accordion / Cards List -->
  <div class="mt-6 space-y-5" id="roadmapContainer">
    
    <!-- Stage 01: Completed -->
    <div class="roadmap-card glass-panel rounded-3xl p-6 sm:p-7 border-emerald-500/30 transition-all duration-300" data-status="completed">
      <div class="flex flex-wrap items-center justify-between gap-4 cursor-pointer select-none card-toggle">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 font-mono font-black text-[18px] flex items-center justify-center shrink-0">
            01
          </div>
          <div>
            <div class="flex items-center gap-3">
              <h2 class="font-display font-bold text-[18px] text-pistachio">التشخيص والتنظيف الأولي (Pulse 360° Diagnostic)</h2>
              <span class="px-3 py-0.5 rounded-full text-[10.5px] font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                مكتمل وموثق ✓
              </span>
            </div>
            <p class="text-[13px] text-pistachio/60 font-sub mt-0.5">مسح شامل لبيانات الفريق، قياس معدل التسرب 41%، وحساب مؤشر صحة المنظمة التقديري.</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-[11px] font-mono text-emerald-400">100% مخرجات</span>
          <span class="text-pistachio/40 text-[18px] transform transition-transform duration-200 card-arrow">▼</span>
        </div>
      </div>

      <!-- Expandable Deliverables Body -->
      <div class="card-body mt-5 pt-5 border-t border-white/[0.08] space-y-4">
        <div class="text-[12px] font-mono text-lime font-bold">المخرجات المعتمدة في هذه المحطة:</div>
        <div class="grid md:grid-cols-3 gap-3.5">
          <div class="rounded-2xl p-4 bg-canvas border border-white/10 space-y-2">
            <div class="flex justify-between items-center">
              <span class="font-bold text-pistachio text-[13px]">وثيقة التشخيص الرقمي</span>
              <span class="text-emerald-400 text-[11px]">معتمد ✓</span>
            </div>
            <p class="text-[12px] text-pistachio/60 font-sub">تقرير تفصيلي بمسببات تسرب الأعضاء وضعف التنسيق الداخلي.</p>
            <div class="pt-2 flex items-center justify-between text-[11px] font-mono">
              <span class="text-pistachio/40">Doc #999-DIAG-01</span>
              <button class="text-lime hover:underline preview-doc-btn" data-doc="diag">معاينة التقرير</button>
            </div>
          </div>

          <div class="rounded-2xl p-4 bg-canvas border border-white/10 space-y-2">
            <div class="flex justify-between items-center">
              <span class="font-bold text-pistachio text-[13px]">مصفوفة الاحتكاك (Friction)</span>
              <span class="text-emerald-400 text-[11px]">معتمد ✓</span>
            </div>
            <p class="text-[12px] text-pistachio/60 font-sub">خريطة الاختناقات في تدفق القرارات بين اللجان والإدارة العليا.</p>
            <div class="pt-2 flex items-center justify-between text-[11px] font-mono">
              <span class="text-pistachio/40">Friction Index: 72/100</span>
              <button class="text-lime hover:underline preview-doc-btn" data-doc="friction">معاينة المصفوفة</button>
            </div>
          </div>

          <div class="rounded-2xl p-4 bg-canvas border border-white/10 space-y-2">
            <div class="flex justify-between items-center">
              <span class="font-bold text-pistachio text-[13px]">الختم الرقمي الأولي</span>
              <span class="text-emerald-400 text-[11px]">SHA-256 ✓</span>
            </div>
            <p class="text-[12px] text-pistachio/60 font-sub">توثيق تشفيري لحالة المنظمة بتاريخ البدء لمنع تضارب البيانات.</p>
            <div class="pt-2 flex items-center justify-between text-[11px] font-mono">
              <span class="text-pistachio/40">Sig: 9f8a...c32d</span>
              <span class="text-lime">QR جاهز</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stage 02: Active In Progress -->
    <div class="roadmap-card glass-panel rounded-3xl p-6 sm:p-7 border-lime/40 ring-1 ring-lime/30 shadow-[0_0_30px_rgba(163,230,53,0.1)] transition-all duration-300" data-status="active">
      <div class="flex flex-wrap items-center justify-between gap-4 cursor-pointer select-none card-toggle">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-lime/20 border border-lime text-lime font-mono font-black text-[18px] flex items-center justify-center shrink-0 animate-pulse">
            02
          </div>
          <div>
            <div class="flex items-center gap-3">
              <h2 class="font-display font-bold text-[18px] text-pistachio">اعتماد الهيكل التنظيمي ومسار الـ Onboarding (RACI)</h2>
              <span class="px-3 py-0.5 rounded-full text-[10.5px] font-mono font-bold bg-lime/15 text-lime border border-lime/30">
                المرحلة النشطة الحالية ●
              </span>
            </div>
            <p class="text-[13px] text-pistachio/60 font-sub mt-0.5">توزيع الصلاحيات عبر مصفوفة RACI، بطاقات التوصيف، وبروتوكول دمج الأعضاء الجدد.</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-[11px] font-mono text-lime font-bold">65% قيد المراجعة</span>
          <span class="text-pistachio/40 text-[18px] transform transition-transform duration-200 card-arrow">▼</span>
        </div>
      </div>

      <!-- Expandable Deliverables Body -->
      <div class="card-body mt-5 pt-5 border-t border-white/[0.08] space-y-4">
        <div class="flex items-center justify-between">
          <div class="text-[12px] font-mono text-lime font-bold">المهام والمخرجات التنفيذية:</div>
          <span class="text-[11px] font-mono text-amber-300">مطلوب موافقة العميل على البند الثاني</span>
        </div>

        <div class="space-y-3">
          <!-- Deliverable 1 -->
          <div class="rounded-2xl p-4 bg-canvas border border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div class="space-y-1">
              <div class="font-bold text-pistachio text-[14px] flex items-center gap-2">
                <span>مصفوفة RACI الموزعة (3 مستويات قيادية)</span>
                <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-500/15 text-emerald-300">تم التجهيز</span>
              </div>
              <p class="text-[12.5px] text-pistachio/60 font-sub">مسؤول وحيد (Accountable) لكل تسليم، مع تحديد فرق الدعم والتنفيذ لكل لجنة.</p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button class="px-3 py-1.5 rounded-xl bg-surface border border-white/15 text-pistachio text-[11.5px] hover:border-lime/40 transition reprompt-btn" data-task="raci">
                طلب تعديل بالـ AI 🪄
              </button>
              <button class="px-3.5 py-1.5 rounded-xl bg-lime text-canvas font-bold text-[11.5px] hover:scale-105 transition approve-task-btn">
                اعتماد النهائي ✓
              </button>
            </div>
          </div>

          <!-- Deliverable 2 -->
          <div class="rounded-2xl p-4 bg-canvas border border-lime/30 flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div class="space-y-1">
              <div class="font-bold text-pistachio text-[14px] flex items-center gap-2">
                <span>بروتوكول Buddy System لدمج الأعضاء الجدد (10 أيام)</span>
                <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-amber-400/20 text-amber-300">مراجعة مفتوحة</span>
              </div>
              <p class="text-[12.5px] text-pistachio/60 font-sub">ربط كل عضو جديد بزميل خبير لخفض صدمة البدايات ورفع نسبة البقاء لـ 88%.</p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button class="px-3 py-1.5 rounded-xl bg-surface border border-white/15 text-pistachio text-[11.5px] hover:border-lime/40 transition reprompt-btn" data-task="buddy">
                تبسيط للأعضاء 🪄
              </button>
              <button class="px-3.5 py-1.5 rounded-xl bg-lime text-canvas font-bold text-[11.5px] hover:scale-105 transition approve-task-btn">
                اعتماد النهائي ✓
              </button>
            </div>
          </div>

          <!-- Deliverable 3 -->
          <div class="rounded-2xl p-4 bg-canvas border border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div class="space-y-1">
              <div class="font-bold text-pistachio text-[14px] flex items-center gap-2">
                <span>لائحة الاجتماعات الصباحية (10-Min Standups Protocol)</span>
                <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white/10 text-pistachio/60">قيد الصياغة</span>
              </div>
              <p class="text-[12.5px] text-pistachio/60 font-sub">قواعد صارمة تمنع الاجتماعات العقيمة وتوثق فقط المعوقات (Blockers) على لوحة الكانبان.</p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button class="px-3 py-1.5 rounded-xl bg-surface border border-white/15 text-pistachio text-[11.5px] hover:border-lime/40 transition reprompt-btn" data-task="standup">
                إضافة جدول زمني 🪄
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stage 03: Upcoming / Ready -->
    <div class="roadmap-card glass-panel rounded-3xl p-6 sm:p-7 border-white/10 opacity-90 transition-all duration-300" data-status="upcoming">
      <div class="flex flex-wrap items-center justify-between gap-4 cursor-pointer select-none card-toggle">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-surface border border-white/15 text-pistachio/60 font-mono font-black text-[18px] flex items-center justify-center shrink-0">
            03
          </div>
          <div>
            <div class="flex items-center gap-3">
              <h2 class="font-display font-bold text-[18px] text-pistachio">استوديو الرعاة وحملة الاستقطاب التجاري (Sponsorship Deck)</h2>
              <span class="px-3 py-0.5 rounded-full text-[10.5px] font-mono font-bold bg-white/10 text-pistachio/60">
                جاهز للإطلاق (20%)
              </span>
            </div>
            <p class="text-[13px] text-pistachio/60 font-sub mt-0.5">تصميم باقات الرعاية Gold/Silver/Bronze ورسائل الاستقطاب الباردة للشركات والبنوك.</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-[11px] font-mono text-pistachio/50">يبدأ خلال 4 أيام</span>
          <span class="text-pistachio/40 text-[18px] transform transition-transform duration-200 card-arrow">▼</span>
        </div>
      </div>

      <!-- Expandable Deliverables Body -->
      <div class="card-body mt-5 pt-5 border-t border-white/[0.08] space-y-4">
        <div class="grid md:grid-cols-2 gap-3.5">
          <div class="p-4 rounded-2xl bg-canvas border border-white/10 space-y-1.5">
            <div class="font-bold text-pistachio text-[13.5px]">عرض الرعاية التفاعلي (16 Slide Pitch Deck)</div>
            <p class="text-[12px] text-pistachio/60 font-sub">بناء سردية الأثر الاجتماعي والأرقام المحققة لجذب قطاعات التكنولوجيا المالية والاتصالات.</p>
            <div class="pt-2 flex items-center gap-2">
              <span class="text-[10.5px] font-mono text-lime">جاهز للتخصيص</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-canvas border border-white/10 space-y-1.5">
            <div class="font-bold text-pistachio text-[13.5px]">مصفوفة الشركات المستهدفة (Top 50 Sponsors)</div>
            <p class="text-[12px] text-pistachio/60 font-sub">قائمة جهات الاتصال المباشرة بمديري التسؤولية المجتمعية والـ PR مع رسائل مسبقة الصياغة.</p>
            <div class="pt-2 flex items-center gap-2">
              <span class="text-[10.5px] font-mono text-pistachio/50">بانتهاء اعتماد الهيكل</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stage 04: Upcoming / Locked -->
    <div class="roadmap-card glass-panel rounded-3xl p-6 sm:p-7 border-white/10 opacity-75 transition-all duration-300" data-status="upcoming">
      <div class="flex flex-wrap items-center justify-between gap-4 cursor-pointer select-none card-toggle">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-surface border border-white/10 text-pistachio/40 font-mono font-black text-[18px] flex items-center justify-center shrink-0">
            04
          </div>
          <div>
            <div class="flex items-center gap-3">
              <h2 class="font-display font-bold text-[18px] text-pistachio">المتابعة والختم المشفر والتقييم الشهري (Audit & SLA)</h2>
              <span class="px-3 py-0.5 rounded-full text-[10.5px] font-mono font-bold bg-white/5 text-pistachio/40">
                في الانتظار (0%)
              </span>
            </div>
            <p class="text-[13px] text-pistachio/50 font-sub mt-0.5">تقارير شهرية مختومة رقمياً وموثقة بكود QR تؤكد استقرار الموارد البشرية وخفض التسرب لأقل من 12%.</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-[11px] font-mono text-pistachio/40">يبدأ في الأسبوع 4</span>
          <span class="text-pistachio/40 text-[18px] transform transition-transform duration-200 card-arrow">▼</span>
        </div>
      </div>

      <!-- Expandable Deliverables Body -->
      <div class="card-body mt-5 pt-5 border-t border-white/[0.08] space-y-4">
        <div class="p-4 rounded-2xl bg-canvas border border-white/10 text-[12.5px] text-pistachio/60 font-sub">
          سيتم فتح هذه المحطة فور اعتماد حملة الرعاة، وتتضمن إصدار شهادة الاعتماد التنظيمي المشفرة وتدريب قيادات الصف الثاني.
        </div>
      </div>
    </div>

  </div>

  <!-- Interactive Cryptographic Master Plan Modal -->
  <div id="pdfMasterModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="w-full max-w-2xl bg-surface border border-lime/40 rounded-3xl p-6 sm:p-8 shadow-[0_0_60px_rgba(163,230,53,0.2)] relative space-y-6" dir="rtl">
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl overflow-hidden border border-lime/40">
            <img src="/logo_999x.jpg" class="w-full h-full object-cover" alt="" />
          </div>
          <div>
            <h3 class="font-display font-bold text-pistachio text-[17px]">وثيقة خارطة الطريق المعتمدة — 999x Master Blueprint</h3>
            <div class="text-[11px] font-mono text-lime">Cryptographically Certified PDF • Hash #sha256-4299x</div>
          </div>
        </div>
        <button id="closePdfMasterModal" class="p-2 text-pistachio/60 hover:text-white text-[18px]">✕</button>
      </div>

      <!-- Certificate Preview Box -->
      <div class="p-5 rounded-2xl bg-canvas border border-white/10 space-y-4 font-sub text-[13px] leading-relaxed">
        <div class="flex justify-between items-start border-b border-white/[0.08] pb-3">
          <div>
            <span class="text-pistachio/50 text-[11px] font-mono">ORGANIZATION</span>
            <div class="font-bold text-pistachio text-[15px]">Enactus Cairo — Central Hub</div>
          </div>
          <div class="text-left">
            <span class="text-pistachio/50 text-[11px] font-mono">STATUS</span>
            <div class="text-lime font-mono font-bold">STAGE 02 IN-PROGRESS (46%)</div>
          </div>
        </div>

        <p class="text-pistachio/85">
          تشهد إدارة العمليات في منظومة <b>999x Operations & Client Hub</b> باعتماد مسار إعادة الهيكلة التنظيمية لفريق إناكتس القاهرة، واجتياز مرحلة التشخيص الأولي بنجاح بنسبة استقرار مستهدفة تتجاوز 88%.
        </p>

        <!-- QR Code Simulation -->
        <div class="p-3.5 rounded-xl bg-surface border border-lime/20 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-lg bg-white p-1 flex items-center justify-center shrink-0">
              <!-- Inline QR SVG -->
              <svg viewBox="0 0 24 24" class="w-full h-full text-canvas" fill="currentColor">
                <path d="M2 2h8v8H2V2zm2 2v4h4V4H4zm10-2h8v8h-8V2zm2 2v4h4V4h-4zM2 14h8v8H2v-8zm2 2v4h4v-4H4zm14-2h4v2h-4v-2zm-4 0h2v4h-2v-4zm2 4h4v4h-4v-4zm-4 2h2v2h-2v-2z"/>
              </svg>
            </div>
            <div>
              <div class="font-mono text-[11px] text-lime font-bold">999x CRYPTOGRAPHIC QR AUDIT</div>
              <div class="text-[10px] font-mono text-pistachio/50">Scan to verify authentic signed audit record</div>
            </div>
          </div>
          <span class="px-2 py-1 rounded bg-emerald-500/20 text-emerald-400 font-mono text-[10.5px] font-bold">VERIFIED</span>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <button id="downloadPdfBtn" class="px-6 h-11 btn-lime text-[13px] font-bold flex items-center gap-2">
          <span>تحميل الوثيقة الآن (PDF) ↓</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Interactive Script -->
  <script>
    // Accordion Toggle
    document.querySelectorAll(".card-toggle").forEach((header) => {
      header.addEventListener("click", () => {
        const card = header.closest(".roadmap-card");
        const body = card?.querySelector(".card-body");
        const arrow = card?.querySelector(".card-arrow");
        if (body) {
          body.classList.toggle("hidden");
          if (arrow) {
            arrow.textContent = body.classList.contains("hidden") ? "◀" : "▼";
          }
        }
      });
    });

    // Stage Filters
    const filterButtons = document.querySelectorAll(".stage-filter-btn");
    const cards = document.querySelectorAll(".roadmap-card");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => {
          b.className = "stage-filter-btn px-4 py-2 rounded-xl bg-surface border border-white/10 text-pistachio/70 hover:border-lime/30 transition";
        });
        btn.className = "stage-filter-btn px-4 py-2 rounded-xl bg-lime text-canvas font-bold transition";

        const filter = btn.getAttribute("data-filter");
        cards.forEach((card) => {
          const status = card.getAttribute("data-status");
          if (filter === "all" || status === filter) {
            (card as HTMLElement).style.display = "block";
          } else {
            (card as HTMLElement).style.display = "none";
          }
        });
      });
    });

    // Reprompt button notification
    document.querySelectorAll(".reprompt-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const task = btn.getAttribute("data-task");
        alert(`🪄 تم إرسال طلب إعادة الصياغة الذكية للمهمة [${task}] إلى محرك Minimax M3 عبر OpenRouter. يتم التحديث فوراً!`);
      });
    });

    // Approve task button
    document.querySelectorAll(".approve-task-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        btn.textContent = "معتمد بنجاح ✓";
        (btn as HTMLElement).className = "px-3.5 py-1.5 rounded-xl bg-emerald-500/20 text-emerald-300 font-mono text-[11.5px] font-bold border border-emerald-500/30";
      });
    });

    // PDF Master Modal
    const pdfModal = document.getElementById("pdfMasterModal");
    const openPdfBtn = document.getElementById("btnOpenPdfModal");
    const closePdfBtn = document.getElementById("closePdfMasterModal");
    const downloadPdfBtn = document.getElementById("downloadPdfBtn");

    openPdfBtn?.addEventListener("click", () => pdfModal?.classList.remove("hidden"));
    closePdfBtn?.addEventListener("click", () => pdfModal?.classList.add("hidden"));
    pdfModal?.addEventListener("click", (e) => {
      if (e.target === pdfModal) pdfModal.classList.add("hidden");
    });
    downloadPdfBtn?.addEventListener("click", async () => {
      const api = (window as any).PUBLIC_API_URL || 'http://localhost:3001';
      const clientId = new URLSearchParams(location.search).get('id') || JSON.parse(localStorage.getItem('999x_client')||'{}').id || 'demo';
      try{
        const res = await fetch(`${api}/api/ai/generate-report`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ clientId, reportType:'MONTHLY_AUDIT' }) });
        if(res.ok){ const j=await res.json(); alert('تم توليد PDF الحقيقي: ' + j.data.pdf.url); window.open(j.data.pdf.url,'_blank'); }
        else throw new Error();
      }catch{
        alert("✓ جاري تنزيل ملف 999x-Roadmap-Blueprint-Enactus.pdf الموقع رقمياً (محلي)...");
      }
      pdfModal?.classList.add("hidden");
    });

    // REAL API — fetch roadmap
    (async ()=>{
      const api = (window as any).PUBLIC_API_URL || 'http://localhost:3001';
      let clientId = new URLSearchParams(location.search).get('id');
      if(!clientId) try{ clientId=JSON.parse(localStorage.getItem('999x_client')||'null')?.id; }catch{}
      if(!clientId) return;
      try{
        const res = await fetch(`${api}/api/clients/${clientId}/roadmap`);
        if(res.ok){
          const j=await res.json();
          console.log('[999x] roadmap real', j.data);
          // update progress if needed
          const prog = document.querySelector('.h-full.bg-gradient-to-r');
          if(prog && j.data.client?.healthScore) prog.style.width = Math.min(100, j.data.client.healthScore) + '%';
        }
      }catch{}
    })();
  </script>
</DashboardLayout>
